diff --git a/doomgeneric/v_video.c b/doomgeneric/v_video.c
index 6db28aa..87dbdff 100644
--- a/doomgeneric/v_video.c
+++ b/doomgeneric/v_video.c
@@ -156,38 +156,38 @@ void V_DrawPatch(int x, int y, patch_t *patch)
             return;
     }
 
-#ifdef RANGECHECK
-    if (x < 0
-     || x + SHORT(patch->width) > SCREENWIDTH
-     || y < 0
-     || y + SHORT(patch->height) > SCREENHEIGHT)
-    {
-        I_Error("Bad V_DrawPatch x=%i y=%i patch.width=%i patch.height=%i topoffset=%i leftoffset=%i", x, y, patch->width, patch->height, patch->topoffset, patch->leftoffset);
-    }
-#endif
+    // snom: the 2024 re-release IWADs (KEX doom.wad/doom2.wad) ship
+    // widescreen graphics (e.g. a 560x200 TITLEPIC). Centre anything wider
+    // than the screen and clip per pixel instead of aborting with I_Error.
+    w = SHORT(patch->width);
+    if (w > SCREENWIDTH && x <= 0)
+        x -= (w - SCREENWIDTH) / 2;
 
-    V_MarkRect(x, y, SHORT(patch->width), SHORT(patch->height));
+    V_MarkRect(x < 0 ? 0 : x, y < 0 ? 0 : y,
+               w > SCREENWIDTH ? SCREENWIDTH : w,
+               SHORT(patch->height) > SCREENHEIGHT ? SCREENHEIGHT : SHORT(patch->height));
 
     col = 0;
-    desttop = dest_screen + y * SCREENWIDTH + x;
-
-    w = SHORT(patch->width);
+    desttop = dest_screen + x;
 
     for ( ; col<w ; x++, col++, desttop++)
     {
+        if (x < 0 || x >= SCREENWIDTH)
+            continue;
+
         column = (column_t *)((byte *)patch + LONG(patch->columnofs[col]));
 
         // step through the posts in a column
         while (column->topdelta != 0xff)
         {
+            int row = y + column->topdelta;
             source = (byte *)column + 3;
-            dest = desttop + column->topdelta*SCREENWIDTH;
             count = column->length;
 
-            while (count--)
+            for ( ; count--; row++, source++)
             {
-                *dest = *source++;
-                dest += SCREENWIDTH;
+                if (row >= 0 && row < SCREENHEIGHT)
+                    desttop[row * SCREENWIDTH] = *source;
             }
             column = (column_t *)((byte *)column + column->length + 4);
         }
