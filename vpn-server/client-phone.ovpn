# snom phone OpenVPN client profile
# Upload this to the phone via its web UI: Advanced > VPN > OpenVPN
#
# !! You still need to add the two snom-specific directives from the
# !! encrypted.at article at the top of this file to trigger startsshd.

client
dev tun
proto udp
remote 192.168.2.196 1194
resolv-retry infinite
nobind
persist-key
persist-tun
cipher AES-256-GCM
verb 3
key-direction 1
script-security 2
up /usr/local/bin/startsshd

