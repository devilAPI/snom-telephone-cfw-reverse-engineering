#!/bin/sh
# CFW: recent kernel and CFW logs.
echo "Content-type: text/html"
echo ""
esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
echo '<!doctype html><meta charset="utf-8"><title>Logs</title><style>body{font:15px system-ui,sans-serif;max-width:900px;margin:auto;padding:16px}pre{background:#eee;padding:8px;overflow-x:auto;font-size:12px}</style><h1>Logs</h1>'
echo '<h2>Kernel</h2><pre>'; dmesg 2>/dev/null | tail -n 150 | esc; echo '</pre>'
for f in /tmp/doom.log /tmp/nes.log /tmp/cfw.log; do
    [ -f "$f" ] && { echo "<h2>$f</h2><pre>"; tail -n 60 "$f" | esc; echo '</pre>'; }
done
echo '<p><a href="/">Back</a></p>'
