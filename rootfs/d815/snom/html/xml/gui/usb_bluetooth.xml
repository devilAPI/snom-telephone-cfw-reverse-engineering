<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneBatch xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schemas/minibrowser.xsd">
  <!-- Menu for Bluetooth -->
  <IPPhoneMenu track="no" speedselect="off" id="usb_bt_menu">
    <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
      <If condition="$(var_ifc:UsbBluetoothManager::state)==Discovering">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_discovering). $(lang:please_wait)">
          <ExtraIconType>$(math_eval:$(icon_type_enum:kIconTypeMenuConnectzero)+$(var:animationcounter))</ExtraIconType>
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <If condition="$(var:animationcounter)==3">
          <Fetch mil="200">phone://mb_nop#var:animationcounter=0</Fetch>
        </If>
        <Else>
          <Fetch mil="200">phone://mb_nop#var:animationcounter=$(math_eval:$(var:animationcounter)+1)</Fetch>
        </Else>
      </If>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Pairing">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(var_ifc:$(var:pairingtoname)$(var:pairingtonameindex))">
          <SubText>$(lang:bluetooth_pairing). $(lang:please_wait)</SubText>
          <ExtraIconType>$(math_eval:$(icon_type_enum:kIconTypeMenuConnectzero)+$(var:animationcounter))</ExtraIconType>
          <ExtraIconType2>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType2>
          <!-- TODO: Needs custom icon depending on device type -->
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <If condition="$(var:animationcounter)==3">
          <Fetch mil="200">phone://mb_nop#var:animationcounter=0</Fetch>
        </If>
        <Else>
          <Fetch mil="200">phone://mb_nop#var:animationcounter=$(math_eval:$(var:animationcounter)+1)</Fetch>
        </Else>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Unpairing">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(var_ifc:UsbBluetoothManager::connected_device)">
          <Subtext>$(lang:bluetooth_unpairing). $(lang:please_wait)</Subtext>
          <ExtraIconType>$(math_eval:$(icon_type_enum:kIconTypeMenuConnectzero)+$(var:animationcounter))</ExtraIconType>
          <ExtraIconType2>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType2>
          <!-- TODO: Needs custom icon depending on device type -->
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <If condition="$(var:animationcounter)==3">
          <Fetch mil="200">phone://mb_nop#var:animationcounter=0</Fetch>
        </If>
        <Else>
          <Fetch mil="200">phone://mb_nop#var:animationcounter=$(math_eval:$(var:animationcounter)+1)</Fetch>
        </Else>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Connecting">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(var_ifc:UsbBluetoothManager::paired_device)">
          <Subtext>$(lang:bluetooth_connecting). $(lang:please_wait)</Subtext>
          <ExtraIconType>$(math_eval:$(icon_type_enum:kIconTypeMenuConnectzero)+$(var:animationcounter))</ExtraIconType>
          <ExtraIconType2>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType2>
          <!-- TODO: Needs custom icon depending on device type -->
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <If condition="$(var:animationcounter)==3">
          <Fetch mil="200">phone://mb_nop#var:animationcounter=0</Fetch>
        </If>
        <Else>
          <Fetch mil="200">phone://mb_nop#var:animationcounter=$(math_eval:$(var:animationcounter)+1)</Fetch>
        </Else>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Disconnecting">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(var_ifc:UsbBluetoothManager::connected_device)">
          <Subtext>$(lang:bluetooth_disconnecting). $(lang:please_wait)</Subtext>
          <ExtraIconType>$(math_eval:$(icon_type_enum:kIconTypeMenuConnectzero)+$(var:animationcounter))</ExtraIconType>
          <ExtraIconType2>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType2>
          <!-- TODO: Needs custom icon depending on device type -->
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <If condition="$(var:animationcounter)==3">
          <Fetch mil="200">phone://mb_nop#var:animationcounter=0</Fetch>
        </If>
        <Else>
          <Fetch mil="200">phone://mb_nop#var:animationcounter=$(math_eval:$(var:animationcounter)+1)</Fetch>
        </Else>
      </Elif>
      <Elif condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::has_discovered_list))">
        <SoftKeyItem>
          <Name>F2</Name>
          <Label>F_PAIR</Label>
          <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Bonding,index=$[sel]&amp;var:pairingtoname=UsbBluetoothManager::discovered_device.&amp;var:pairingtonameindex=$[sel]</Url>
        </SoftKeyItem>
        <Title>$(lang:bluetooth)</Title>
        <Repeat values="$(enum:$(var_ifc:UsbBluetoothManager::discovered_number))" token="|__INDEX__|">
          <MenuItem name="$(var_ifc:UsbBluetoothManager::discovered_device.__INDEX__)" id="__INDEX__">
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType>
            <!-- TODO: Needs custom icon depending on device type -->
            <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Bonding,index=__INDEX__&amp;var:pairingtoname=UsbBluetoothManager::discovered_device.__INDEX__&amp;var:pairingtonameindex=</Url>
          </MenuItem>
        </Repeat>
      </Elif>
      <Elif condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::has_connected_device))">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(var_ifc:UsbBluetoothManager::connected_device)">
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuPaired)</ExtraIconType>
          <ExtraIconType2>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType2>
          <!-- TODO: Needs custom icon depending on device type -->
          <SubText>$(lang:bluetooth_connected_title)</SubText>
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Elif>
      <Elif condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::has_paired_list))">
        <Title>$(lang:bluetooth)</Title>
        <Repeat values="$(enum:$(var_ifc:UsbBluetoothManager::paired_number))" token="|__INDEX__|">
          <MenuItem name="$(var_ifc:UsbBluetoothManager::paired_device.__INDEX__)" id="paired_device.__INDEX__">
            <Subtext>$(lang:query_pending)</Subtext>
            <!-- Temporary "Searching..."" text -->
            <ExtraIconType>$(math_eval:$(icon_type_enum:kIconTypeMenuConnectzero)+$(var:animationcounter))</ExtraIconType>
            <ExtraIconType2>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType2>
            <!-- TODO: Needs custom icon depending on device type -->
            <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Connect,index=__INDEX__</Url>
          </MenuItem>
        </Repeat>
        <If condition="$(var:animationcounter)==3">
          <Fetch mil="200">phone://mb_nop#var:animationcounter=0</Fetch>
        </If>
        <Else>
          <Fetch mil="200">phone://mb_nop#var:animationcounter=$(math_eval:$(var:animationcounter)+1)</Fetch>
        </Else>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==NotReady">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_not_ready)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <Fetch mil="1000">phone://mb_nop</Fetch>
      </Elif>
      <Else>
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:list_no_devices)">
          <URL>phone://mb_nop</URL>
        </MenuItem>
      </Else>
      <If condition="$(bool_eval:$(condition:!$(var_ifc:UsbBluetoothManager::has_connected_device)) &amp; $(condition:!$(var_ifc:UsbBluetoothManager::has_paired_list)) &amp; $(condition:$(var_ifc:UsbBluetoothManager::state)!=NotReady))">
        <SoftKeyItem>
          <Name>F1</Name>
          <Label>F_SEARCH</Label>
          <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Discover</Url>
        </SoftKeyItem>
      </If>
      <If condition="$(bool_eval:$(condition:$(var_ifc:UsbBluetoothManager::has_connected_device)) | $(condition:$(var_ifc:UsbBluetoothManager::has_paired_list)))">
        <SoftKeyItem>
          <Name>F2</Name>
          <Label>F_UNPAIR</Label>
          <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Unpair</Url>
        </SoftKeyItem>
      </If>
    </If>
    <Else>
      <If condition="$(var_ifc:UsbBluetoothManager::state)==Discovering">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_discovering). $(lang:please_wait)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </If>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Pairing">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_pairing). $(lang:please_wait)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Unpairing">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_unpairing). $(lang:please_wait)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Connecting">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_connecting). $(lang:please_wait)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==Disconnecting">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_disconnecting). $(lang:please_wait)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Elif>
      <Elif condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::has_discovered_list))">
        <SoftKeyItem>
          <Name>F2</Name>
          <Label>$(lang:ok)</Label>
          <SoftKey>F_OK</SoftKey>
        </SoftKeyItem>
        <Title>$(lang:bluetooth)</Title>
        <MenuSubTitle name="$(lang:bluetooth_discovered_list_title)"></MenuSubTitle>
        <Repeat values="$(enum:$(var_ifc:UsbBluetoothManager::discovered_number))" token="|__INDEX__|">
          <MenuItem name="$(var_ifc:UsbBluetoothManager::discovered_device.__INDEX__)" id="discovered_device.__INDEX__">
            <Image default="file:///bmp/colored/snom_headset.png"></Image>
            <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Bonding,index=__INDEX__</Url>
          </MenuItem>
        </Repeat>
      </Elif>
      <Elif condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::has_connected_device))">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(var_ifc:UsbBluetoothManager::connected_device)">
          <MenuSubTitle name="$(lang:bluetooth_connected_title):"></MenuSubTitle>
          <Image default="file:///bmp/colored/snom_headset.png"></Image>
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Elif>
      <Elif condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::has_paired_list))">
        <Title>$(lang:bluetooth)</Title>
        <MenuSubTitle name="$(lang:bluetooth_paired_list_title)"></MenuSubTitle>
        <Repeat values="$(enum:$(var_ifc:UsbBluetoothManager::paired_number))" token="|__INDEX__|">
          <MenuItem name="$(var_ifc:UsbBluetoothManager::paired_device.__INDEX__)" id="paired_device.__INDEX__">
            <Image default="file:///bmp/colored/snom_headset.png"></Image>
            <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Connect,index=__INDEX__</Url>
          </MenuItem>
        </Repeat>
      </Elif>
      <Elif condition="$(var_ifc:UsbBluetoothManager::state)==NotReady">
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:bluetooth_not_ready)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
        <Fetch mil="1000">phone://mb_nop</Fetch>
      </Elif>
      <Else>
        <Title>$(lang:bluetooth)</Title>
        <MenuItem name="$(lang:list_no_devices)">
          <Url>phone://mb_nop</Url>
        </MenuItem>
      </Else>
      <If condition="$(bool_eval:$(condition:!$(var_ifc:UsbBluetoothManager::has_connected_device)) &amp; $(condition:!$(var_ifc:UsbBluetoothManager::has_paired_list)) &amp; $(condition:$(var_ifc:UsbBluetoothManager::state)!=NotReady))">
        <SoftKeyItem>
          <Name>F1</Name>
          <Label>F_SEARCH</Label>
          <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Discover</Url>
        </SoftKeyItem>
      </If>
      <If condition="$(bool_eval:$(condition:$(var_ifc:UsbBluetoothManager::has_connected_device)) | $(condition:$(var_ifc:UsbBluetoothManager::has_paired_list)))">
        <SoftKeyItem>
          <Name>F2</Name>
          <Label>F_UNPAIR</Label>
          <Url>file:///xml/gui/usb_bluetooth.xml#action_ifc:UsbBluetoothManager=Unpair</Url>
        </SoftKeyItem>
      </If>
    </Else>
  </IPPhoneMenu>
</IPPhoneBatch>
