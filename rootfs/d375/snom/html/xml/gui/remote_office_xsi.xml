<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneBatch xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schemas/minibrowser.xsd">
  <IPPhoneMenu dtmf="off" id="remote_office_menu">
    <Title>$(lang:remote_office)</Title>
    <MenuItem name="$(lang:enable_remote_office)" id="activate">
      <SubText>$(yes_no:$(condition:$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_enable)==enabled))</SubText>
      <If condition="$(empty:$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_number))">
        <Url track="no">file:///xml/gui/remote_office_xsi.xml#sub=*[@id="phoneNumberAndToggle"]</Url>
      </If>
      <Else>
        <Url track="no">file:///xml/gui/remote_office_xsi.xml#action_ifc:identity.$(set:active_line).server_settings_xsi=set_remote_office,enable=toggle</Url>
      </Else>
      <If condition="$(bool_eval:$(condition:$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_enable)==enabled))">
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
      </If>
      <Else>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
      </Else>
    </MenuItem>
    <If condition="$(bool_eval:$(condition:$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_enable)==enabled))">
      <MenuItem name="$(lang:number_str)" id="phoneNumberMenu">
        <Url track="no">file:///xml/gui/remote_office_xsi.xml#sub=*[@id="phoneNumber"]</Url>
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_number)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
      </MenuItem>
    </If>
  </IPPhoneMenu>
  <IPPhoneInput id="phoneNumber" state="others_except_mb">
    <Title>$(lang:number_str)</Title>
    <Url track="no">file:///xml/gui/remote_office_xsi.xml#sub=*[@id="remote_office_menu"]&amp;action_ifc:identity.$(set:active_line).server_settings_xsi=set_remote_office,phoneNumber=__X__</Url>
    <InputItem>
      <DisplayName>$(lang:number_str)</DisplayName>
      <InputToken>__X__</InputToken>
      <InputFlags>t</InputFlags>
      <DefaultValue>$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_number)</DefaultValue>
      <ContactPoolInEdit>1</ContactPoolInEdit>
    </InputItem>
  </IPPhoneInput>
  <IPPhoneInput id="phoneNumberAndToggle" state="others_except_mb">
    <Title>$(lang:number_str)</Title>
    <Url track="no">file:///xml/gui/remote_office_xsi.xml#sub=*[@id="remote_office_menu"]&amp;action_ifc:identity.$(set:active_line).server_settings_xsi=set_remote_office,phoneNumber=__X__,enable=toggle</Url>
    <InputItem>
      <DisplayName>$(lang:number_str)</DisplayName>
      <InputToken>__X__</InputToken>
      <InputFlags>t</InputFlags>
      <DefaultValue>$(var_ifc:identity.$(set:active_line).server_settings_xsi::remote_office_number)</DefaultValue>
      <ContactPoolInEdit>1</ContactPoolInEdit>
    </InputItem>
  </IPPhoneInput>
</IPPhoneBatch>
