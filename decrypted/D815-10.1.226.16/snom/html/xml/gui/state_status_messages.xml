              </Elif>
              <Else>
                <SoftKey>F_DETAILS</SoftKey>
              </Else>
            </SoftKeyItem>
          </If>
          <If condition="__ESSENTIAL__==0">
            <If condition="$(var:list_type)==important">
              <SoftKeyItem>
                <Name>F3</Name>
                <SoftKey>F_DELETE</SoftKey>
              </SoftKeyItem>
            </If>
          </If>
          <SoftKeyItem>
            <Name>F4</Name>
            <SoftKey>STATE_IDLE_FKEY4</SoftKey>
            <Icon>$(set:context_key_icon_type[3])</Icon>
            <Label>$(key_name_default_idle_f4)</Label>
          </SoftKeyItem>
        </If>
        <Else>
          <SoftKeyItem>
            <Name>ENTER</Name>
            <If condition="__Y__==-1">
              <Url>phone://mb_nop</Url>
            </If>
            <Elif condition="$(status_message_id:UxmUpdateRequired)==__Y__">
              <Url>file:///xml/gui/templates.xml#sub=*[@id="text_template"]&amp;var:text_translate=yes&amp;var:text_content=$(lang:status_detail_uxm_update_required)%3Cbr/%3E$(lang:status_detail_uxm_update_required2)&amp;var:text_title=$(lang:message_label)&amp;var:text_softkeys=|F1|F_SOFTWARE_UPDATE|phone://mb_nop#uxm_update=file:///uxm/uxm_update.bin||</Url>
            </Elif>
            <Elif condition="$(status_message_id:WlanStatus)==__Y__">
              <Url>file:///xml/wifi/wifi.xml#sub=*[@id="SIOwlan"]</Url>
            </Elif>
            <Else>
              <SoftKey>F_DETAILS</SoftKey>
            </Else>
          </SoftKeyItem>
          <If condition="__Y__!=-1">
            <SoftKeyItem>
              <Name>F3</Name>
              <If condition="$(status_message_id:UxmUpdateRequired)==__Y__">
                <Label>F_DETAILS</Label>
                <Url>file:///xml/gui/templates.xml#sub=*[@id="text_template"]&amp;var:text_translate=yes&amp;var:text_content=$(lang:status_detail_uxm_update_required)%3Cbr/%3E$(lang:status_detail_uxm_update_required2)&amp;var:text_title=$(lang:message_label)&amp;var:text_softkeys=|F1|F_SOFTWARE_UPDATE|phone://mb_nop#uxm_update=file:///uxm/uxm_update.bin||</Url>
              </If>
              <Elif condition="$(status_message_id:WlanStatus)==__Y__">
                <Label>F_DETAILS</Label>
                <Url>file:///xml/wifi/wifi.xml#sub=*[@id="SIOwlan"]</Url>
              </Elif>
              <Else>
                <SoftKey>F_DETAILS</SoftKey>
              </Else>
            </SoftKeyItem>
          </If>
          <If condition="__ESSENTIAL__==0">
            <If condition="$(var:list_type)==important">
              <SoftKeyItem>
                <Name>F4</Name>
