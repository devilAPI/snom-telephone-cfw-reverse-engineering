<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneBatch xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schemas/minibrowser.xsd">
<IPPhoneMenu state="others_except_mb" dtmf="off" document_id="maintenance">
  <Title>$(lang:maintenance_settings)</Title>
  <Menu name="$(lang:menu_security)" id="security">
    <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
      <MenuItem name="$(lang:sel100_admin_mode)" id="mode">
        <If condition="!$(set:admin_mode)">
          <SubText>$(lang:off)</SubText>
          <Action>admin_mode</Action>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
        </If>
        <Else>
          <SubText>$(lang:on)</SubText>
          <Url>phone://mb_nop#set:admin_mode=off</Url>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
        </Else>
      </MenuItem>
    </If>
    <Else>
      <If condition="!$(set:admin_mode)">
        <MenuItem name="$(lang:sel100_admin_mode)" id="mode">
          <Action>admin_mode</Action>
        </MenuItem>
      </If>
      <Else>
        <MenuItem name="$(lang:sel100_user_mode)" id="mode">
          <Action>user_mode</Action>
        </MenuItem>
      </Else>
    </Else>
    <If condition="!$(set:keyboard_lock_pw)">
      <MenuItem name="$(lang:menu_set_kbd_lock_pin)">
        <Action>change_pin</Action>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
      </MenuItem>
    </If>
    <Else>
      <MenuItem name="$(lang:menu_change_kbd_lock_pin)">
        <Action>change_pin</Action>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
      </MenuItem>
    </Else>
  </Menu>
  <MenuItem name="$(lang:continuous_text_reboot)">
    <ExtraIconType>$(icon_type_enum:kIconTypeMenuReboot)</ExtraIconType>
    <Action>reboot</Action>
  </MenuItem>
  <If condition="$(set:admin_mode)">
    <MenuItem name="$(lang:reset_settings)">
      <ExtraIconType>$(icon_type_enum:kIconTypeMenuReset)</ExtraIconType>
      <Action>reset_settings</Action>
    </MenuItem>
  </If>
  <If condition="$(show_feature:FEATURE_TR369)">
    <If condition="$(set:tr369_enable1)!=always">
      <If condition="$(set:admin_mode)">
        <Menu name="$(lang:device_management_service)" id="dms">
          <MenuItem name="$(lang:manage_dms)" id="manage_dms">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <If condition="$(set:tr369_enable1)==false">
                <SubText>$(lang:off)</SubText>
              </If>
              <Else>
                <SubText>$(local_time:get_date;$(set:tr369_enable1);d.m.y) $(local_time:get_HMS;$(set:tr369_enable1))</SubText>
              </Else>
            </If>
            <If condition="$(set:tr369_enable1)==false">
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
              <Url>phone://mb_nop#set:tr369_enable1=3d</Url>
            </If>
            <Else>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
              <Url>phone://mb_nop#set:tr369_enable1=false</Url>
            </Else>
          </MenuItem>
        </Menu>
      </If>
    </If>
  </If>
  <MenuItem name="$(lang:sync_settings)">
    <ExtraIconType>$(icon_type_enum:kIconTypeMenuRefresh)</ExtraIconType>
    <Url>file:///xml/gui/maintenance.xml#sub=*[@id="sync_settings"]</Url>
  </MenuItem>
  <If condition="$(int_eval:$(set:tbook_download_interval[$(set:active_line)]):-1) > -1">
    <MenuItem name="$(lang:tbook_download)" id="tbook_download">
      <ExtraIconType>$(icon_type_enum:kIconTypeMenuDownload)</ExtraIconType>
      <Url>file:///xml/gui/templates.xml#sub=*[@id="text_template"]&amp;var:text_translate=no&amp;var:text_content=$(lang:start_tbook_download)&amp;var:text_title=$(lang:tbook_download)&amp;var:text_softkeys=|F1|F_OK|phone://mb_exit#contact_tbook_sync=$(set:active_line)||F4|F_CANCEL|phone://mb_nop#go_back||</Url>
    </MenuItem>
  </If>
  <If condition="$(var_ifc:StorageManager::is_storage_mounted)">
    <MenuItem name="$(lang:storage_umount)">
      <Url>phone://mb_exit#action_ifc:StorageManager=umount</Url>
    </MenuItem>
  </If>
  <If condition="$(phone_state)!=Settings">
    <SoftKeyItem>
      <Name>CANCEL</Name>
      <Url track="no">phone://mb_nop#go_back</Url>
    </SoftKeyItem>
  </If>
</IPPhoneMenu>
<IPPhoneText track="no" id="sync_settings" document_id="sync_settings">
  <Title>$(lang:sync_settings)</Title>
  <Text>$(lang:confirm_sync_settings)</Text>
  <If condition="$(show_feature:ORDER_CANCEL_LEFT_OK_RIGHT)">
    <SoftKeyItem>
      <Name>F1</Name>
      <Label>F_CANCEL</Label>
      <Url>phone://mb_nop#go_back</Url>
    </SoftKeyItem>
    <SoftKeyItem>
      <Name>F4</Name>
      <Label>F_OK</Label>
      <Url>phone://mb_exit#reloadset</Url>
    </SoftKeyItem>
    <SoftKeyItem>
      <Name>ENTER</Name>
      <Url>phone://mb_exit#reloadset</Url>
    </SoftKeyItem>
  </If>
  <Else>
    <SoftKeyItem>
      <Name>F1</Name>
      <Label>F_OK</Label>
      <Url>phone://mb_exit#reloadset</Url>
    </SoftKeyItem>
    <SoftKeyItem>
      <Name>F4</Name>
      <Label>F_CANCEL</Label>
      <Url>phone://mb_nop#go_back</Url>
    </SoftKeyItem>
    <SoftKeyItem>
      <Name>ENTER</Name>
      <Url>phone://mb_exit#reloadset</Url>
    </SoftKeyItem>
  </Else>
</IPPhoneText>
</IPPhoneBatch>
