<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneBatch xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schemas/minibrowser.xsd">
<IPPhoneMenu state="others_except_mb" dtmf="off" document_id="preferences">
  <Title>$(lang:preferences_settings)</Title>
  <Menu name="$(lang:language)" sort="yes" viewportcontrol="ShowSelectedLineAtBottom" speedselect="off">
    <Repeat values="$(language_list)" token="|__LANG__|">
      <MenuItem name=" __LANG__" sel="$(condition:__IDX__==$(selected_language_index_number))" id="lang__IDX__" sort_key="__LANG__">
        <If condition="__IDX__==$(selected_language_index_number)">
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType>
        </If>
        <Else>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType>
        </Else>
        <Url>phone://mb_nop#go_back&amp;set:language=__LANG__</Url>
        <SoftKeyItem>
          <Name>F1</Name>
          <SoftKey>F_JUMP</SoftKey>
        </SoftKeyItem>
        <SoftKeyItem>
          <Name>F4</Name>
          <SoftKey>F_JUMP_BACK</SoftKey>
        </SoftKeyItem>
      </MenuItem>
    </Repeat>
    <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
      <SubText>$(set:language)</SubText>
    </If>
  </Menu>
  <Menu name="$(lang:date_and_time)" id="datetime">
    <If condition="$(set:admin_mode)">
      <Menu name="$(lang:menu100_timezone)" viewportcontrol="ShowSelectedLineAtBottom" speedselect="off">
        <Url>file:///xml/gui/preferences.xml#sub=*[@id="timezone_list"]&amp;var:index=&amp;var:reduced_list=</Url>
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(set:timezone)</SubText>
        </If>
      </Menu>
    </If>
    <MenuItem name="$(lang:prefs_ssi_date_us_format): $(date)" id="date_us_format">
      <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
        <SubText>$(on_off:$(set:date_us_format))</SubText>
      </If>
      <Url>phone://mb_nop#toggleset:date_us_format</Url>
      <If condition="$(bool_eval:$(set:date_us_format))">
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
      </If>
      <Else>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
      </Else>
    </MenuItem>
    <MenuItem name="$(lang:prefs_ssi_time_24_format): $(time)" id="time_24_format">
      <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
        <SubText>$(on_off:$(set:time_24_format))</SubText>
      </If>
      <Url>phone://mb_nop#toggleset:time_24_format</Url>
      <If condition="$(bool_eval:$(set:time_24_format))">
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
      </If>
      <Else>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
      </Else>
    </MenuItem>
    <If condition="!$(ntp_active)">
      <MenuItem name="$(lang:current_time)" id="current_time">
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(time)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
        <If condition="$(set:time_24_format)">
          <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:current_time)&amp;var:input_token=__Y__&amp;var:input_flags=a&amp;var:input_default=$(time)&amp;var:input_mask=99:99&amp;var:input_url=$(urlencode:"phone://mb_nop%23go_back%26action_ifc:date_time=set,time=__Y__")</Url>
        </If>
        <Else>
          <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:current_time)&amp;var:input_token=__Y__&amp;var:input_flags=a&amp;var:input_default=$(time)&amp;var:input_mask=99:99AA&amp;var:input_url=$(urlencode:"phone://mb_nop%23go_back%26action_ifc:date_time=set,time=__Y__")</Url>
        </Else>
      </MenuItem>
      <MenuItem name="$(lang:current_date)">
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(date)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
        <If condition="$(set:date_us_format)">
          <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:current_date)&amp;var:input_token=__Y__&amp;var:input_flags=a&amp;var:input_default=$(date)&amp;var:input_mask=99/99/9999&amp;var:input_url=$(urlencode:"phone://mb_nop%23go_back%26action_ifc:date_time=set,date=__Y__")</Url>
        </If>
        <Else>
          <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:current_date)&amp;var:input_token=__Y__&amp;var:input_flags=a&amp;var:input_default=$(date)&amp;var:input_mask=99.99.9999&amp;var:input_url=$(urlencode:"phone://mb_nop%23go_back%26action_ifc:date_time=set,date=__Y__")</Url>
        </Else>
      </MenuItem>
    </If>
  </Menu>
  <Menu name="$(lang:audio_settings)" id="audiosettings">
    <If condition="$(show_feature:FEATURE_HEADSET_DETECT)">
      <MenuItem name="$(lang:headset_detection)">
        <If condition="$(bool_eval:$(set:headset_available_detect))">
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
        </If>
        <Else>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
        </Else>
        <SubText>$(on_off:$(set:headset_available_detect))</SubText>
        <Url>phone://mb_nop#toggleset:headset_available_detect</Url>
      </MenuItem>
    </If>
    <Menu name="$(lang:menu100_dialtone)" sort="yes" viewportcontrol="ShowSelectedLineAtBottom" speedselect="off">
      <Repeat values="$(tone_scheme_list)" token="|__COUNTRY__|__SCHEME__|">
        <MenuItem name=" __COUNTRY__" sel="$(condition:__SCHEME__==$(set:tone_scheme))" id="scheme__IDX__" sort_key="__COUNTRY__">
          <If condition="__SCHEME__==$(set:tone_scheme)">
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType>
          </If>
          <Else>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType>
          </Else>
          <Url>phone://mb_nop#go_back&amp;set:tone_scheme=__SCHEME__</Url>
          <SoftKeyItem>
            <Name>F1</Name>
            <SoftKey>F_JUMP</SoftKey>
          </SoftKeyItem>
          <SoftKeyItem>
            <Name>F4</Name>
            <SoftKey>F_JUMP_BACK</SoftKey>
          </SoftKeyItem>
        </MenuItem>
      </Repeat>
      <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
        <SubText>$(set:tone_scheme)</SubText>
      </If>
      <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
    </Menu>
    <MenuItem name="$(lang:menu_gen_ringtone)">
      <Action>ringtone</Action>
      <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
    </MenuItem>
    <If condition="$(bool_eval:$(condition:$(var_ifc:BluetoothManager::ready)) | $(condition:$(var_ifc:BluetoothManager::has_usb_bt_stick)))">
      <MenuItem name="$(lang:bluetooth)">
        <Url>file:///xml/gui/bluetooth.xml</Url>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
      </MenuItem>
    </If>
    <If condition="$(bool_eval:$(var_ifc:UsbBluetoothManager::bluetooth_toggle_available))">
      <Menu name="$(lang:bluetooth)" id="bluetooth">
        <MenuItem name="$(lang:bluetooth)">
          <If condition="$(bool_eval:$(set:bt_enabled))">
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
          </If>
          <Else>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
          </Else>
          <SubText>$(on_off:$(set:bt_enabled))</SubText>
          <Url>phone://mb_nop#toggleset:bt_enabled</Url>
        </MenuItem>
        <If condition="$(bool_eval:$(set:bt_enabled))">
          <MenuItem name="$(lang:bluetooth_devices)">
            <Url>file:///xml/gui/usb_bluetooth.xml#sub=*[@id="usb_bt_menu"]&amp;action_ifc:UsbBluetoothManager=InView&amp;var:animationcounter=0</Url>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
          </MenuItem>
        </If>
      </Menu>
    </If>
    <Elif condition="$(var_ifc:UsbBluetoothManager::state)!=NotReady">
      <MenuItem name="$(lang:bluetooth)">
        <Url>file:///xml/gui/usb_bluetooth.xml#sub=*[@id="usb_bt_menu"]&amp;action_ifc:UsbBluetoothManager=InView&amp;var:animationcounter=0</Url>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
      </MenuItem>
    </Elif>
    <Menu name="$(lang:menu_volume)" id="volumesettings">
      <MenuItem name="$(lang:vol_ringer_text)">
        <Action>vol_ringer</Action>
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(set:vol_ringer)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuRinger)</ExtraIconType>
      </MenuItem>
      <MenuItem name="$(lang:vol_speaker_text)">
        <Action>vol_speaker</Action>
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(set:vol_speaker)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuSpeaker)</ExtraIconType>
      </MenuItem>
      <MenuItem name="$(lang:vol_handset_text)">
        <Action>vol_handset</Action>
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(set:vol_handset)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuHandset)</ExtraIconType>
      </MenuItem>
      <MenuItem name="$(lang:vol_headset_text)">
        <Action>vol_headset</Action>
        <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
          <SubText>$(set:vol_headset)</SubText>
        </If>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuHeadset)</ExtraIconType>
      </MenuItem>
    </Menu>
  </Menu>
  <Menu name="$(lang:display_settings)" id="display">
    <!-- Primary Display Settings if more than one display is available-->
    <If condition="$(bool_eval:$(condition:$(var_ifc:UsbExpansionModule::NumberOfExpansionModules)&gt;0)
    | $(bool_eval:$(show_feature:FEATURE_SECOND_DISPLAY))
    | $(condition:$(uxm_color_count)&gt;0))">
    <Menu name="$(lang:menu_primary_display)" id="primary_display">
      <Url>file:///xml/gui/preferences_display.xml#var:display_menu_name=menu_primary_display</Url>
    </Menu>
    </If>
    <!-- Primary Display Settings if only one display is available-->
    <Else>
      <Url>file:///xml/gui/preferences_display.xml#var:display_menu_name=display_settings</Url>
    </Else>
    <!-- Second Display Settings-->
    <If condition="$(bool_eval:$(show_feature:FEATURE_SECOND_DISPLAY))">
      <Menu name="$(lang:menu_secondary_display)" id="second_display">
        <MenuItem name="$(lang:menu_gen_contrast)">
          <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
            <SubText>$(set:label_contrast)</SubText>
          </If>
          <Action>label_contrast</Action>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
        </MenuItem>
        <If condition="$(show_feature:LABEL_ADJUSTABLE_BACKLIGHT)">
          <MenuItem name="$(lang:backlight_on_activity)">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(set:label_backlight)</SubText>
            </If>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
            <Action>label_backlight_active</Action>
          </MenuItem>
          <MenuItem name="$(lang:backlight_when_idle)">
            <Action>label_backlight_idle</Action>
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(set:label_backlight_idle)</SubText>
            </If>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
          </MenuItem>
        </If>
        <Menu name="$(lang:menu_title_text_options)">
          <MenuItem name="$(lang:menu_fontsize)">
            <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:menu_fontsize)&amp;var:input_token=__Y__&amp;var:input_flags=N&amp;var:input_default=$(set:label_font_size)&amp;var:input_mask=&amp;var:input_url=$(urlencode:"phone://mb_nop#go_back&amp;set:label_font_size=__Y__")</Url>
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(set:label_font_size)</SubText>
            </If>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
          </MenuItem>
          <Menu name="$(lang:menu_text_alignment)">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(lang:$(set:label_text_alignment))</SubText>
            </If>
            <MenuItem name="$(lang:alternate)" sel="$(condition:$(set:label_text_alignment)==alternate)">
              <If condition="$(set:label_text_alignment)==alternate">
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType2>
              </If>
              <Else>
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType2>
              </Else>
              <Url>phone://mb_nop#go_back&amp;set:label_text_alignment=alternate</Url>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuAlignAlternate)</ExtraIconType>
            </MenuItem>
            <MenuItem name="$(lang:center)" sel="$(condition:$(set:label_text_alignment)==center)">
              <If condition="$(set:label_text_alignment)==center">
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType2>
              </If>
              <Else>
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType2>
              </Else>
              <Url>phone://mb_nop#go_back&amp;set:label_text_alignment=center</Url>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuAlignCenter)</ExtraIconType>
            </MenuItem>
            <MenuItem name="$(lang:left)" sel="$(condition:$(set:label_text_alignment)==left)">
              <If condition="$(set:label_text_alignment)==left">
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType2>
              </If>
              <Else>
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType2>
              </Else>
              <Url>phone://mb_nop#go_back&amp;set:label_text_alignment=left</Url>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuAlignLeft)</ExtraIconType>
            </MenuItem>
            <MenuItem name="$(lang:right)" sel="$(condition:$(set:label_text_alignment)==right)">
              <If condition="$(set:label_text_alignment)==right">
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType2>
              </If>
              <Else>
                <ExtraIconType2>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType2>
              </Else>
              <Url>phone://mb_nop#go_back&amp;set:label_text_alignment=right</Url>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuAlignRight)</ExtraIconType>
            </MenuItem>
          </Menu>
        </Menu>
        <Menu name="$(lang:menu_return_to_first_page)">
          <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
            <If condition="$(set:label_scroll_timeout)=0">
              <SubText>$(lang:off)</SubText>
            </If>
            <Else>
              <SubText>$(set:label_scroll_timeout)$(lang:time_symbol_second)</SubText>
            </Else>
          </If>
          <MenuItem name="$(lang:automatic_return)">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(on_off:$(condition:$(set:label_scroll_timeout)>0))</SubText>
            </If>
            <If condition="$(bool_eval:$(condition:$(set:label_scroll_timeout)>0))">
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOn)</ExtraIconType>
            </If>
            <Else>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuSliderOff)</ExtraIconType>
            </Else>
            <!-- If label_scroll_timeout == 0, toggle it to set a value-->
            <!-- Else. toggle it to set the value to 0 -->
            <If condition="$(set:label_scroll_timeout) > 0">
              <Url>phone://mb_nop#set:label_scroll_timeout=0</Url>
            </If>
            <Else>
              <Url>phone://mb_nop#set:label_scroll_timeout=60</Url>
            </Else>
          </MenuItem>
          <!-- MenuItem to change the timeout-->
          <If condition="$(set:label_scroll_timeout) > 0">
            <MenuItem name="$(lang:menu_tser_timer)">
              <SubText>$(set:label_scroll_timeout)$(lang:time_symbol_second)</SubText>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
              <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:menu_tser_timer)&amp;var:input_token=__Y__&amp;var:input_flags=t&amp;var:input_default=$(set:label_scroll_timeout)&amp;var:input_mask=&amp;var:input_url=$(urlencode:"mb_nop#go_back&amp;set:label_scroll_timeout=__Y__")</Url>
            </MenuItem>
          </If>
        </Menu>
      </Menu>
    </If>
    <!-- Expansion Module Settings -->
    <If condition="$(mod_ifc:UsbExpansionModule)">
      <If condition="$(bool_eval:$(condition:$(var_ifc:UsbExpansionModule::NumberOfExpansionModules)>0))">
        <Menu name="$(lang:expansion_modules)" id="exp_mod">
          <MenuItem name="$(lang:backlight_on_activity)">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(set:uxm_backlight)</SubText>
            </If>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
            <Action>uxm_backlight_active</Action>
          </MenuItem>
          <MenuItem name="$(lang:backlight_when_idle)">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(set:uxm_backlight_idle)</SubText>
            </If>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
            <Action>uxm_backlight_idle</Action>
          </MenuItem>
          <MenuItem name="$(lang:menu_gen_contrast)">
            <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
              <SubText>$(set:uxm_contrast)</SubText>
            </If>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
            <Action>uxm_contrast</Action>
          </MenuItem>
          <Menu name="$(lang:uxm_appearance)">
            <Repeat values="$(enum:$(var_ifc:UsbExpansionModule::NumberOfExpansionModules))" token="|__EXP__|">
              <MenuItem id="EXP__EXP__" name="$(lang:expansion_layout) $(math_eval:__IDX__+1)">
                <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
                  <SubText>$(lang:$(set:uxm_screen_layout[__EXP__]))</SubText>
                </If>
                <If condition="$(set:uxm_screen_layout[__EXP__])==Lines">
                  <ExtraIconType>$(icon_type_enum:kIconTypeMenuLines)</ExtraIconType>
                  <Url>phone://mb_nop#set:uxm_screen_layout[__EXP__]=Tiles&amp;menu=$[current_path]&amp;sel=$[sel]</Url>
                </If>
                <Else>
                  <ExtraIconType>$(icon_type_enum:kIconTypeMenuTiles)</ExtraIconType>
                  <Url>phone://mb_nop#set:uxm_screen_layout[__EXP__]=Lines&amp;menu=$[current_path]&amp;sel=$[sel]</Url>
                </Else>
              </MenuItem>
            </Repeat>
            <MenuItem name="$(lang:uxm_fontsize_lines)">
              <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
                <SubText>$(set:uxm_line_font_size)</SubText>
              </If>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
              <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:uxm_fontsize_lines)&amp;var:input_token=__Y__&amp;var:input_flags=N&amp;var:input_default=$(set:uxm_line_font_size)&amp;var:input_mask=&amp;var:input_url=$(urlencode:"phone://mb_nop#go_back&amp;set:uxm_line_font_size=__Y__")</Url>
            </MenuItem>
            <MenuItem name="$(lang:uxm_fontsize_tiles)">
              <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
                <SubText>$(set:uxm_tile_font_size)</SubText>
              </If>
              <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
              <Url>file:///xml/gui/templates.xml#sub=*[@id="input_template"]&amp;var:input_pool_key=0&amp;var:input_displayname=$(lang:uxm_fontsize_tiles)&amp;var:input_token=__Y__&amp;var:input_flags=N&amp;var:input_default=$(set:uxm_tile_font_size)&amp;var:input_mask=&amp;var:input_url=$(urlencode:"phone://mb_nop#go_back&amp;set:uxm_tile_font_size=__Y__")</Url>
            </MenuItem>
          </Menu>
        </Menu>
      </If>
    </If>
    <!--uxm color settings-->
    <If condition="$(uxm_color_count)&gt;0">
      <Menu name="$(lang:expansion_modules)" id="uxm_color_display_settings">
        <MenuItem name="$(lang:backlight_on_activity)">
          <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
            <SubText>$(set:expansion_module_backlight)</SubText>
          </If>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
          <Action>expansion_module_backlight</Action>
        </MenuItem>
        <MenuItem name="$(lang:backlight_when_idle)">
          <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
            <SubText>$(set:expansion_module_backlight_idle)</SubText>
          </If>
          <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
          <Action>expansion_module_backlight_idle</Action>
        </MenuItem>
        <Menu name="$(lang:uxm_appearance)">
          <MenuItem name="$(lang:screen_items_color_and_opacity_title)">
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
            <Url>file:///xml/gui/color_transparency.xml</Url>
          </MenuItem>
          <Menu name="$(lang:menu_fontsize)" id="uxm_color_fontsize">
            <Subtext>$(lang:expansion_module_color_font_sizes_$(set:expansion_module_maintext_size)_$(set:expansion_module_subtext_size))</Subtext>
            <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
            <repeat values="|XXL|XS|XL|S|XL|XS|L|M|L|S|L|XS|M|M|M|S|M|XS|S|S|S|XS|XS|XS|" token="|__MAINTEXT__|__SUBTEXT__|">
              <MenuItem name="$(lang:expansion_module_color_font_sizes___MAINTEXT_____SUBTEXT__)" id="__FONTSIZE_COMBO___IDX__" sel="$(condition:$(bool_eval:$(condition:$(set:expansion_module_maintext_size)==__MAINTEXT__) &amp; $(condition:$(set:expansion_module_subtext_size)==__SUBTEXT__)))">
                <Url>phone://mb_nop#go_back&amp;set:expansion_module_maintext_size=__MAINTEXT__&amp;set:expansion_module_subtext_size=__SUBTEXT__</Url>
                <If condition="$(bool_eval:$(condition:$(set:expansion_module_maintext_size)==__MAINTEXT__) &amp; $(condition:$(set:expansion_module_subtext_size)==__SUBTEXT__))">
                  <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType>
                </If>
                <Else>
                  <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType>
                </Else>
              </MenuItem>
            </repeat>
          </Menu>
          <Menu name="$(lang:expansion_module_text_alignment)">
            <SubText>$(lang:$(set:expansion_module_text_alignment))</SubText>
            <repeat values="|left|right|" token="|__alignment__|">
              <MenuItem name="$(lang:__alignment__)" sel="$(condition:$(set:expansion_module_text_alignment)==__alignment__)">
                <If condition="__alignment__==$(set:expansion_module_text_alignment)">
                  <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType>
                </If>
                <Else>
                  <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType>
                </Else>
                <Url>phone://mb_nop#go_back&amp;set:expansion_module_text_alignment=__alignment__</Url>
              </MenuItem>
            </repeat>
          </Menu>
        </Menu>
      </Menu>
    </If>
  </Menu>
  <If condition="$(bool_eval:$(condition:$(set:phone_type)!=snomMP) &amp; $(bool_eval:$(max_pkey_units)))">
    <MenuItem name="$(lang:menu_function_key)">
      <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
      <Url>file:///xml/gui/pkeys.xml#sub=*[@id="units"]</Url>
    </MenuItem>
  </If>
  <MenuItem name="$(lang:preferences_general)">
    <ExtraIconType>$(icon_type_enum:kIconTypeMenuArrowRight)</ExtraIconType>
    <Url>file:///xml/gui/preferences_general.xml</Url>
  </MenuItem>
  <If condition="$(phone_state)!=Settings">
    <SoftKeyItem>
      <Name>CANCEL</Name>
      <Url track="no">phone://mb_nop#go_back</Url>
    </SoftKeyItem>
  </If>
</IPPhoneMenu>
<IPPhoneMenu id="timezone_list" state="others_except_mb" dtmf="off" document_id="timezone_list">
  <Title>$(lang:menu100_timezone)</Title>
  <Repeat values="$(timezone_list:$(var:reduced_list))" token="|__ZONE__|__NAME__|__KEY__|__IDX__|__JUMP_TARGET__|__JUMP_BACK_TARGET__">
    <MenuItem name="__NAME__" sel="$(bool_eval:$(condition:__KEY__==$(set:timezone))&amp;$(empty:$(var:index)))" timezone="__IDX__">
      <If condition="__KEY__==$(set:timezone)">
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOn)</ExtraIconType>
      </If>
      <Else>
        <ExtraIconType>$(icon_type_enum:kIconTypeMenuRadioOff)</ExtraIconType>
      </Else>
      <Icon>__ZONE__</Icon>
      <Url>phone://mb_nop#go_back&amp;set:timezone=__KEY__&amp;var:index=&amp;var:reduced_list=</Url>
      <SoftKeyItem>
        <Name>F1</Name>
        <Label>F_JUMP</Label>
        <Url>phone://mb_nop#sel=[@timezone=__JUMP_TARGET__]&amp;var:index="@timezone"</Url>
      </SoftKeyItem>
      <SoftKeyItem>
        <Name>F2</Name>
        <If condition="$(var:reduced_list)==1">
          <Label>F_ALL</Label>
          <Url>phone://mb_nop_ignore_prev_frags#var:reduced_list=0</Url>
        </If>
        <Else>
          <Label>F_REDUCED</Label>
          <Url>phone://mb_nop_ignore_prev_frags#var:reduced_list=1</Url>
        </Else>
      </SoftKeyItem>
      <SoftKeyItem>
        <Name>F4</Name>
        <Label>F_JUMP_BACK</Label>
        <Url>phone://mb_nop#sel=[@timezone=__JUMP_BACK_TARGET__]&amp;var:index="@timezone"</Url>
      </SoftKeyItem>
      <SoftKeyItem>
        <Name>RIGHT</Name>
        <Url>phone://mb_nop#sel=[@timezone=__JUMP_TARGET__]&amp;var:index="@timezone"</Url>
      </SoftKeyItem>
      <SoftKeyItem>
        <Name>LEFT</Name>
        <Url>phone://mb_nop#sel=[@timezone=__JUMP_BACK_TARGET__]&amp;var:index="@timezone"</Url>
      </SoftKeyItem>
    </MenuItem>
  </Repeat>
</IPPhoneMenu>
</IPPhoneBatch>
