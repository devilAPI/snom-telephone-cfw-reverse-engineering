<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneBatch xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../schemas/minibrowser.xsd">
  <IPPhoneMenu state="others_except_mb" dtmf="off" id="blf_monitor">
    <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
      <Title>$(lang:lang_monitored_extensions)</Title>
    </If>
    <Else>
      <Title>$(lang:lang_linetype_blf)</Title>
    </Else>
    <Repeat value_key="$(var_ifc:BusyLampField::get_monitored_extensions,$(var:target_identity))" token="|__NAME__|__NUMBER__|__INDEX__|">
      <If condition="!$(empty:__NAME__)">
        <MenuItem name="__NAME__" id="__NUMBER__">
          <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
            <Subtext>__NUMBER__</Subtext>
            <ExtraText>$(lang:linetype_key_event_short) __INDEX__</ExtraText>
          </If>
          <Url>phone://mb_exit#action_ifc:BusyLampField=handle_selected,contact_number=__NUMBER__</Url>
        </MenuItem>
      </If>
      <Else>
        <MenuItem name="__NUMBER__" id="__NUMBER__">
          <If condition="$(show_feature:FEATURE_PUI_STYLE_SIO)">
            <ExtraText>$(lang:linetype_key_event_short) __INDEX__</ExtraText>
          </If>
          <Url>phone://mb_exit#action_ifc:BusyLampField=handle_selected,contact_number=__NUMBER__</Url>
        </MenuItem>
      </Else>
    </Repeat>
  </IPPhoneMenu>
  <IPPhoneMenu state="others_except_mb" dtmf="off"  id="monitor_state" document_id="monitor_state" speedselect="off">
    <Title>$(lang:lang_dialog_title)</Title>
    <Repeat var_ifc="BusyLampField" variable_name="monitoring_list" token="|__NAME__|__IDENTITY__|__KEYID__|__PKEY__|__ISRINGING__|__REMOTE__|__CALLED__|">
      <MenuItem name="__NAME__" id="monitor__IDX__">
        <SoftKeyItem>
          <Name>CANCEL</Name>
          <Url>phone://mb_exit#action_ifc:BusyLampField=handle_cancel_on_dialog</Url>
        </SoftKeyItem>
        <Url>phone://mb_exit#action_ifc:BusyLampField=handle_monitored_extension,monitor_line=__IDENTITY__,monitor_fkey_idx=__KEYID__,monitor_pkey=__PKEY__,monitor_ring=__ISRINGING__,monitor_remote=__REMOTE__,monitor_originally_called=__CALLED__</Url>
      </MenuItem>
    </Repeat>
    <SoftKeyItem>
      <Name>CANCEL</Name>
      <Url>phone://mb_exit#action_ifc:BusyLampField=handle_cancel_on_dialog</Url>
    </SoftKeyItem>
  </IPPhoneMenu>
</IPPhoneBatch>
