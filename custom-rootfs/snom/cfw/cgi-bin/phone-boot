#!/bin/sh
# CFW: start Doom/NES from the phone's own menu. ?game=doom|nes&url=<url>
# (url last: a typed URL may arrive unencoded and contain '&'). Answers with a
# minibrowser text screen; the launcher downloads, then takes over the screen.
echo "Content-type: text/xml"
echo ""
GAME=$(echo "$QUERY_STRING" | sed -n 's/^game=\([a-z]*\)&.*/\1/p')
RAW=${QUERY_STRING#*url=}
URL=$(printf '%b' "$(echo "$RAW" | sed 's/%\(..\)/\\x\1/g')")

msg() {
cat <<EOF2
<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneText dtmf="off">
  <Title>$1</Title>
  <Text>$2</Text>
  <SoftKeyItem>
    <Name>CANCEL</Name>
    <Url track="no">phone://mb_nop#go_back</Url>
  </SoftKeyItem>
</IPPhoneText>
EOF2
}

case "$URL" in http://*|https://*) ;; *) msg "Invalid URL" "Enter an http:// or https:// link."; exit 0 ;; esac
case "$GAME" in
    doom) nohup /snom/cfw/doom/boot-doom.sh "$URL" >/dev/null 2>&1 &
          msg "Starting DOOM" "Downloading the WAD, then DOOM takes over the screen. Red hangup key quits (the phone then restarts). If nothing happens within a minute or two, the download failed." ;;
    nes)  nohup /snom/cfw/nes/boot-nes.sh "$URL" >/dev/null 2>&1 &
          msg "Starting NES" "Downloading the ROM, then the emulator takes over the screen. Red hangup key quits (the phone then restarts)." ;;
    *)    msg "Error" "Unknown game." ;;
esac
