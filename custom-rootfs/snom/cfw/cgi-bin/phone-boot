#!/bin/sh
# CFW: start Doom/NES from the phone's own menu (a .zip works; several games
# inside -> phone-pick shows a list). ?game=doom|nes&url=<url>
# (url last: a typed URL may arrive unencoded and contain '&'). Answers with a
# minibrowser text screen; the launcher downloads, then takes over the screen.
GAME=$(echo "$QUERY_STRING" | sed -n 's/^game=\([a-z]*\)&.*/\1/p')
RAW=${QUERY_STRING#*url=}
URL=$(printf '%b' "$(echo "$RAW" | sed 's/%\(..\)/\\x\1/g')")

msg() {
printf 'Content-type: text/xml\r\n\r\n'
cat <<EOF2
<?xml version="1.0" encoding="UTF-8"?>
<IPPhoneText dtmf="off">
  <Title>$1</Title>
  <Text>$2</Text>
  <SoftKeyItem>
    <Name>CANCEL</Name>
    <Url track="no">phone://mb_nop#go_back</Url>
  </SoftKeyItem>
</IPPhoneText>
EOF2
}

case "$URL" in http://*|https://*) ;; *) msg "Invalid URL" "Enter an http:// or https:// link."; exit 0 ;; esac
case "$GAME" in
    doom|nes) rm -f "/tmp/$GAME.status"
          nohup /snom/cfw/$GAME/boot-$GAME.sh "$URL" </dev/null >/dev/null 2>&1 &
          QUERY_STRING="sys=$GAME&wait=1" exec /snom/cfw/cgi-bin/phone-pick ;;
    *)    msg "Error" "Unknown game." ;;
esac
