#!/bin/sh
# CFW: download a Doom WAD from a user-supplied URL and launch Doom on it.
echo "Content-type: text/html"
echo ""

# Read the POSTed form body and pull out the url field, URL-decoded.
LEN=${CONTENT_LENGTH:-0}
BODY=$(head -c "$LEN" 2>/dev/null)
RAW=$(echo "$BODY" | sed 's/^.*url=//; s/&.*$//')
URL=$(printf '%b' "$(echo "$RAW" | sed 's/+/ /g; s/%\(..\)/\\x\1/g')")

ok=0
case "$URL" in
    http://*|https://*) ok=1 ;;
esac

if [ "$ok" != 1 ]; then
cat <<EOF
<!DOCTYPE html><html><head><meta charset="utf-8"><title>Boot Doom</title>
<style>body{font-family:sans-serif;background:#f0f0f0;padding:24px}
.box{background:#fff;border:1px solid #ccc;border-radius:6px;padding:16px 18px;max-width:520px}
.err{color:#a40}a{color:#2a6}</style></head><body>
<div class="box"><p class="err">Please enter a valid http:// or https:// URL to a WAD.</p>
<p><a href="/">&larr; Back</a></p></div></body></html>
EOF
    exit 0
fi

# Launch detached; the launcher downloads then takes over the screen.
nohup /snom/cfw/doom/boot-doom.sh "$URL" >/dev/null 2>&1 &

cat <<EOF
<!DOCTYPE html><html><head><meta charset="utf-8"><title>Boot Doom</title>
<style>body{font-family:sans-serif;background:#111;color:#eee;padding:24px}
.box{background:#1b1b1b;border:1px solid #600;border-radius:6px;padding:18px 20px;max-width:520px}
h1{color:#c33}a{color:#f66}code{background:#222;padding:1px 4px}</style></head><body>
<div class="box"><h1>Downloading &amp; starting DOOM&hellip;</h1>
<p>Fetching the WAD to RAM, then it runs on the phone screen. If the screen
   doesn't change within a minute or two, the download failed — see the
   <a href="/cgi-bin/doom-log">launcher log</a> for the reason. Direct .wad links,
   archive.org <code>/details/</code> or <code>/download/</code> links and archive.org
   .zip files all work; the WAD must fit in the ~40&nbsp;MB RAM disk.</p>
<p>Controls: nav pad = move/turn, Fire = shoot, Use = open doors, OK = menu,
   <b>red hangup = quit</b> (the phone UI then comes back in about 30 s).</p>
<p><a href="/">&larr; Back to CFW Settings</a></p></div></body></html>
EOF
