#!/bin/sh
# Idle-screen widgets. state_idle.xml is parsed by lcsD375 only at its start, so
# "apply" regenerates the file from state_idle.xml.orig and restarts lcsD375 (lid respawns it).
# Params: action=apply|restore|picture|status  clock=on stats=on picture=on  url=<png url>
. /snom/cfw/lib/cfw.sh
D=$(cfw_data_dir idle); CONF=$D/config
GUI=/snom/html/xml/gui; ORIG=$GUI/state_idle.xml.orig
conf_get() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -1; }
gen() {
    clock=$(conf_get clock); stats=$(conf_get stats); pic=$(conf_get picture)
    B=$(mktemp /tmp/idle.XXXXXX)
    echo '    <InfoBox>' > $B
    [ "$clock" = on ] && echo '      <Line><Text>$(time)</Text></Line>' >> $B
    [ "$stats" = on ] && echo "      <Line><Text>$(/snom/cfw/cgi-bin/idle-widget | cfw_xml_escape)</Text></Line>" >> $B
    if [ "$pic" = on ] && [ -f $D/picture.png ]; then
        ln -sf $D/picture.png /snom/html/bmp/cfw-idle.png
        echo '      <Line><Image>File:///bmp/cfw-idle.png</Image></Line>' >> $B
    fi
    echo '    </InfoBox>' >> $B
    awk -v f=$B '{print} /<SelectedTextHighlight>off/{while((getline l < f)>0)print l}' $ORIG > $GUI/state_idle.xml.new && mv $GUI/state_idle.xml.new $GUI/state_idle.xml
    rm -f $B
}
restart_ui() { kill $(ps | awk '/[l]csD375/{print $1}') 2>/dev/null; }
act=$(cfw_param action)
cfw_rw
case "$act" in
apply)
    printf 'clock=%s\nstats=%s\npicture=%s\n' "$(cfw_param clock)" "$(cfw_param stats)" "$(cfw_param picture)" > $CONF
    gen; restart_ui; msg="Applied; the phone UI restarts (about 20 s)." ;;
restore)
    cp $ORIG $GUI/state_idle.xml; rm -f $CONF; restart_ui; msg="Stock idle screen restored; UI restarts." ;;
picture)
    u=$(cfw_param url)
    case "$u" in http://*|https://*) wget -q -T 15 -O $D/picture.tmp "$u" && head -c4 $D/picture.tmp | grep -q PNG && mv $D/picture.tmp $D/picture.png && msg="Picture stored (480x~150 PNG max). Press Apply." || { rm -f $D/picture.tmp; msg="Download failed or not a PNG."; } ;; *) msg="URL must be http(s)." ;; esac ;;
*) msg="" ;;
esac
cfw_ro
cfw_html_head "Idle screen"
echo "<p>$(printf '%s' "$msg" | cfw_html_escape)</p><p>Config: <code>$(cat $CONF 2>/dev/null | tr '\n' ' ' | cfw_html_escape)</code></p><p><a href=\"/cgi-bin/panel\">Back</a></p>"
cfw_html_foot
