#!/bin/sh
# CFW: what a phone key opens to start a game: ?sys=doom|nes|gb|gba&url=<encoded URL>.
# Set up in the panel's Games tab (cgi-bin/game-keys, lib/key-scripts.sh).
# Starts the game's launcher and returns at once, because the phone waits for this
# answer. The launcher downloads the game, then takes over the screen. A zip with
# several games inside would wait for a choice that a key can't make, so it is
# stopped. The launcher's own log is /tmp/SYS.log; this one is /tmp/key-game.log.
. /snom/cfw/lib/cfw.sh
printf 'Content-type: text/plain\r\n\r\n'
LOG=/tmp/key-game.log
SYS=$(printf '%s' "$QUERY_STRING" | sed -n 's/^sys=\([a-z]*\)&url=.*/\1/p')
URL=$(printf '%s' "${QUERY_STRING#*&url=}" | cfw_urldecode)
case "$SYS" in doom|nes|gb|gba) ;; *) echo "unknown system" | tee "$LOG"; exit 0 ;; esac
case "$URL" in http://*|https://*) ;; *) echo "not an http(s) URL" | tee "$LOG"; exit 0 ;; esac
if cfw_game_running; then echo "a game is already running" | tee "$LOG"; exit 0; fi
{ date; echo "key: $SYS $URL"; } > "$LOG"
logger -t cfw-key-game "$SYS $URL" 2>/dev/null
rm -f "/tmp/$SYS.status"
nohup "/snom/cfw/$SYS/boot-$SYS.sh" "$URL" </dev/null >/dev/null 2>&1 &
# Watch the launcher for a minute in the background, and note in the log how it went.
(
    i=0
    while [ $i -lt 60 ]; do
        S=$(cat "/tmp/$SYS.status" 2>/dev/null)
        case "$S" in
            running*|done*) echo "started" >> "$LOG"; exit 0 ;;
            error*) echo "$S" >> "$LOG"; logger -t cfw-key-game "$S" 2>/dev/null; exit 0 ;;
            choose*) echo "error: the zip holds several games; use a direct link to one" >> "$LOG"
                     rm -f "/tmp/$SYS.status"; exit 0 ;;
        esac
        sleep 1; i=$((i + 1))
    done
    echo "still downloading after 60 s" >> "$LOG"
) </dev/null >/dev/null 2>&1 &
echo started
