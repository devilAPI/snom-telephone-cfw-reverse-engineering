#!/bin/sh
# CFW: download a NES ROM from a user-supplied URL and launch the emulator on it.
echo "Content-type: text/html"
echo ""

LEN=${CONTENT_LENGTH:-0}
BODY=$(head -c "$LEN" 2>/dev/null)
RAW=$(echo "$BODY" | sed 's/^.*url=//; s/&.*$//')
URL=$(printf '%b' "$(echo "$RAW" | sed 's/+/ /g; s/%\(..\)/\\x\1/g')")

ok=0
case "$URL" in
    http://*|https://*) ok=1 ;;
esac

if [ "$ok" != 1 ]; then
cat <<EOF
<!DOCTYPE html><html><head><meta charset="utf-8"><title>Boot NES</title>
<style>body{font-family:sans-serif;background:#f0f0f0;padding:24px}
.box{background:#fff;border:1px solid #ccc;border-radius:6px;padding:16px 18px;max-width:520px}
.err{color:#a40}a{color:#2a6}</style></head><body>
<div class="box"><p class="err">Please enter a valid http:// or https:// URL to a .nes ROM.</p>
<p><a href="/">&larr; Back</a></p></div></body></html>
EOF
    exit 0
fi

nohup /snom/cfw/nes/boot-nes.sh "$URL" >/dev/null 2>&1 &

cat <<EOF
<!DOCTYPE html><html><head><meta charset="utf-8"><title>Boot NES</title>
<style>body{font-family:sans-serif;background:#111;color:#eee;padding:24px}
.box{background:#1b1b1b;border:1px solid #336;border-radius:6px;padding:18px 20px;max-width:520px}
h1{color:#69f}a{color:#9cf}</style></head><body>
<div class="box"><h1>Downloading &amp; starting NES&hellip;</h1>
<p>Fetching the ROM to RAM, then it runs on the phone screen. If the screen
   doesn't change within a minute, the download failed — check the URL.</p>
<p>Controls: nav pad = D-pad, Fire = A, Use = B, OK = Start, Cancel = Select,
   <b>red hangup = quit</b> (the phone UI then comes back in about 30 s).</p>
<p><a href="/">&larr; Back to CFW Settings</a></p></div></body></html>
EOF
