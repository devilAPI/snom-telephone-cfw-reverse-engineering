#!/bin/sh
# CFW: the web panel. Page chrome from lib/cfw.sh plus every panel.d/NN-*.html card
# (one <div class="card"> each) in filename order.
. /snom/cfw/lib/cfw.sh
cfw_html_head "CFW Settings"
cat <<'EOT'
<h1>CFW Settings</h1>
<div class="sub">snom D375 custom firmware</div>

EOT
for f in /snom/cfw/panel.d/*.html; do
    [ -f "$f" ] && cat "$f" && echo
done
cat <<'EOT'
<p class="warn">This page is not password protected. Anyone on the network who can reach this phone can use these buttons, including making it download from a URL.</p>
EOT
cfw_html_foot
