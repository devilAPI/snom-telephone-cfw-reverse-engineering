#!/bin/sh
# CFW: network speaker / reverse intercom (see docs/speaker.md). Plays audio sent to
# http://<phone>:8091/play?k=<token> on the loudspeaker while the phone UI runs.
#   ?a=status|start|stop   [&v=0..100 default volume; start only]
#   ?a=out&o=speaker|handset   loudspeaker or handset earpiece (saved)
#   &fmt=txt   key=value lines (tools/snom-speaker.sh, tests)
#   &fmt=json  JSON (panel card 91-speaker.html)
#   ?a=phone[&do=start|stop]  minibrowser menu for the phone (phone-menu.d/31-speaker)
# All parameters are whitelisted; only the validated volume reaches a command.
. /snom/cfw/lib/cfw.sh
CTL=/snom/cfw/intercom/speaker.sh

A=$(cfw_param a); FMT=$(cfw_param fmt); V=$(cfw_param v)
DO=$(cfw_param "do")
OUTP=$(cfw_param o)
case "$A" in start|stop|status|phone|out) ;; *) A=status ;; esac
case "$OUTP" in speaker|handset) ;; *) OUTP= ;; esac
case "$FMT" in txt|json) ;; *) FMT=json ;; esac
case "$V" in [0-9]|[1-9][0-9]|100) ;; *) V=30 ;; esac
case "$DO" in start|stop|out) ;; *) DO= ;; esac

run_ctl() {
    case "$1" in
        start) "$CTL" start "$V" 2>&1 ;;
        stop)  "$CTL" stop 2>&1 ;;
        out)   if [ -n "$OUTP" ]; then "$CTL" out "$OUTP" 2>&1; else echo "error=o must be speaker or handset"; "$CTL" status; fi ;;
        *)     "$CTL" status 2>&1 ;;
    esac
}
value() { printf '%s\n' "$OUT" | sed -n "s/^$1=//p" | head -n 1; }

if [ "$A" = phone ]; then
    OUT=$(run_ctl "${DO:-status}")
    B="http://127.0.0.1:8081/cgi-bin/speaker?a=phone"
    if [ "$(value running)" = 1 ]; then TITLE="Speaker: ON, receiving"; else TITLE="Speaker: off"; fi
    printf 'Content-type: text/xml\r\n\r\n'
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<IPPhoneMenu state="others_except_mb" dtmf="off">'
    printf '  <Title>%s</Title>\n' "$TITLE"
    item() {
        printf '  <MenuItem name="%s">\n    <Url>%s</Url>\n  </MenuItem>\n' \
            "$(printf '%s' "$1" | cfw_xml_escape)" "$(printf '%s' "$2" | cfw_xml_escape)"
    }
    ERR=$(value error)
    [ -n "$ERR" ] && item "Error: $ERR" "$B"
    if [ "$(value running)" = 1 ]; then
        item "Stop speaker" "$B&do=stop"
        [ "$(value playing)" = 1 ] && item "Playing now (refresh)" "$B" || item "Waiting for sound (refresh)" "$B"
        if [ "$(value out)" = handset ]; then item "Output: handset - switch to speaker" "$B&do=out&o=speaker"
        else item "Output: speaker - switch to handset" "$B&do=out&o=handset"; fi
    else
        item "Start speaker" "$B&do=start"
    fi
    cat <<'EOT'
  <SoftKeyItem>
    <Name>CANCEL</Name>
    <Url track="no">phone://mb_nop#go_back</Url>
  </SoftKeyItem>
</IPPhoneMenu>
EOT
    exit 0
fi

OUT=$(run_ctl "$A")
if [ "$FMT" = txt ]; then
    printf 'Content-type: text/plain\r\n\r\n%s\n' "$OUT"
    exit 0
fi
printf 'Content-type: application/json\r\nCache-Control: no-store\r\n\r\n'
jesc() { sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'; }
printf '{"running":%s,"port":%s,"token":"%s","playing":%s,"vol":%s,"out":"%s","error":"%s"}\n' \
    "$( [ "$(value running)" = 1 ] && echo 1 || echo 0)" \
    "$(value port | tr -cd '0-9' | grep . || echo 0)" \
    "$(value token | tr -cd '0-9a-f')" \
    "$(value playing | tr -cd '0-9' | grep . || echo 0)" \
    "$(value vol | tr -cd '0-9' | grep . || echo 0)" \
    "$(value out | tr -cd 'a-z')" \
    "$(value error | jesc)"
