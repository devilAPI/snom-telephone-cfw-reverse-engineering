#ACTION=="add", SUBSYSTEM=="mem", NAME="%k"

#ACTION=="add", KERNEL=="mtdblock[0-9]", SUBSYSTEM=="block", NAME="%k"
ACTION=="add", KERNEL=="mtd[0-9]", SUBSYSTEM=="mtd", NAME="%k"
